{
  "name": "@arrrnmp/moxen",
  "version": "0.1.2",
  "description": "Drive Moxen projects and threads from the command line.",
  "license": "AGPL-3.0-only",
  "keywords": [
    "moxen",
    "cli",
    "handover",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arrrnmp/moxen.git"
  },
  "homepage": "https://github.com/arrrnmp/moxen#readme",
  "bugs": {
    "url": "https://github.com/arrrnmp/moxen/issues"
  },
  "type": "module",
  "bin": {
    "moxen": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "mods",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "tui": "bun scripts/build.ts && bun scripts/tui.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test",
    "check:tui": "bun src/tui/render-check.tsx",
    "check:tui:shots": "bun src/tui/render-check/shots.tsx",
    "check:tui:frames": "bun src/tui/render-check/shots.tsx --mode frames",
    "check:tui:gallery": "bun src/tui/render-check/shots.tsx --mode gallery",
    "tui:mock": "bun src/tui/mock.tsx",
    "test:inventory": "bun ./scripts/test-inventory.ts",
    "stats:sheet": "bun ./scripts/stats-sheet.ts",
    "update:docs": "bun ./scripts/update-docs.ts",
    "update:tree-sitter-assets": "bun ./scripts/update-tree-sitter-assets.ts --config ./parsers-config.json --assets ./src/core/syntax --output ./src/core/syntax/parsers.ts && bun ./scripts/fetch-tree-sitter-licenses.ts",
    "review:settings": "npm --prefix tools/settings-review run dev"
  },
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@opencode/client": "2.0.24",
    "@opentui/core": "0.5.16",
    "@opentui/react": "0.5.16",
    "commander": "^14.0.1",
    "diff": "9.0.0",
    "effect": "4.0.0-rc.115",
    "react": "^19.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "@opentui/core@0.5.16": "patches/@opentui%2Fcore@0.5.16.patch"
  }
}
